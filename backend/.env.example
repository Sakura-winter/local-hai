# Database URL (SQLAlchemy psycopg format)
# e.g. postgresql+psycopg://username:password@localhost:5432/localhai
# Or local socket: postgresql+psycopg:///localhai
DATABASE_URL=postgresql+psycopg:///localhai

# JWT Authentication
JWT_SECRET=localhai-friendly-neighbourhood-secret-key-2026-spider
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

